# Senso gateway config. setup.sh copies this to /etc/senso/gateway.env if that
# file doesn't exist yet. Fill in your values, then:
#   sudo systemctl restart senso-heartbeat.timer

# The gateway's LoRa concentrator EUI (16 hex chars, no separators).
# This is the ONLY value you normally need to set, per gateway.
GATEWAY_MAC=REPLACE_WITH_GATEWAY_EUI

# Full base URL of the Senso API — already set to production. Change only if
# your API is hosted elsewhere. Include https:// and NO trailing slash.
API_BASE=https://senso-xsbp.vercel.app

# Per-gateway secret. setup.sh auto-generates one on first run if this is empty;
# it must match the `secret` set on this gateway's row in the database.
GATEWAY_SECRET=
