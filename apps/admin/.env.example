# Admin app — admin.sensoqa.com
#
# Copy to .env.local for development. Production values are set in Vercel, never
# in the repo. Placeholders only in this file.
#
# Everything below without the NEXT_PUBLIC_ prefix is server-only and must stay
# that way: the service-role key bypasses RLS entirely, and the two secrets are
# the sole authentication on their endpoints.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Bypasses RLS. Server-side only, and never in the customer app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Ingest ──────────────────────────────────────────────────────────────────
# Bearer token ChirpStack's HTTP integration sends to /api/ingest. Generate with
# `openssl rand -hex 32`; it must match the header configured on the ChirpStack
# application, not the device.
CHIRPSTACK_INGEST_SECRET=generate-with-openssl-rand-hex-32

# ── Network server (ChirpStack) ─────────────────────────────────────────────
# Where the admin app reaches ChirpStack's REST API, and the API key it uses.
# Today this asks a sensor for its stored readings after a gap (backfill); it
# will also register devices from the Devices page. The URL is the dashboard's
# host; Caddy routes /api/ to the REST container (network-server/README.md).
# The key is created under ChirpStack → API keys. With either unset, backfill
# is skipped and every live reading is stored exactly as before.
CHIRPSTACK_API_URL=https://lns.example.com
CHIRPSTACK_API_TOKEN=your-chirpstack-api-key
# Where the Devices page registers hardware: the one tenant, the one
# application and the one device profile (network-server/README.md §8, §9).
# Each is a UUID from the ChirpStack dashboard's address bar on that object's
# page. With any of the three unset, backfill still runs but the Devices page
# says the network server is not connected.
CHIRPSTACK_TENANT_ID=00000000-0000-0000-0000-000000000000
CHIRPSTACK_APPLICATION_ID=00000000-0000-0000-0000-000000000000
CHIRPSTACK_DEVICE_PROFILE_ID=00000000-0000-0000-0000-000000000000

# ── Alert scheduler ─────────────────────────────────────────────────────────
# Bearer token for /api/cron/alerts. The caller is the ChirpStack VPS crontab
# (see network-server/README.md) — this value must match /etc/senso/alerts.env
# there. Generate with `openssl rand -hex 32`.
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── Alert email (Resend) ────────────────────────────────────────────────────
# With either of the first two unset the sender fails closed: alerts stay due
# rather than being marked as notified, so misconfiguration delays alerting
# instead of silently swallowing it.
RESEND_API_KEY=re_your_resend_api_key
# Must be on a domain verified in Resend (sensoqa.com).
ALERT_FROM_EMAIL=alerts@sensoqa.com
# Optional. Where replies to an alert email go.
ALERT_REPLY_TO=support@sensoqa.com

# ── Watchdog ────────────────────────────────────────────────────────────────
# Where platform trouble is reported: the five-minute watchdog's "the VPS is
# down" / "recovered" emails, and the daily "the alert sender has stopped"
# warning. This alerts *us*, never a customer: an outage on our side is our
# failure, and what customers hear about it is a human decision. With this
# unset both checks still run and still log, but cannot tell anyone.
OPS_ALERT_EMAIL=you@example.com

# ── Links in alert emails ───────────────────────────────────────────────────
# The customer app's origin, used to build "view this sensor" links.
CUSTOMER_APP_URL=https://app.sensoqa.com
