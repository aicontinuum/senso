# Customer app — app.sensoqa.com
#
# Copy to .env.local for development. Production values are set in Vercel, never
# in the repo. Placeholders only in this file.
#
# NEXT_PUBLIC_ is a publishing decision, not a naming convention: anything with
# that prefix is inlined into the browser bundle. Only the two Supabase values
# below belong there — they are safe because RLS, not secrecy, is what scopes a
# customer to their own data. Never add a key here that must stay server-side.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
